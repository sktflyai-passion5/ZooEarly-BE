# ── Gradle ──────────────────────────
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# ── IDE ─────────────────────────────
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project
bin/
out/

# ── OS ──────────────────────────────
.DS_Store
Thumbs.db

# ── 환경·비밀값 ──────────────────────
# API 키·비밀번호는 절대 커밋하지 않는다. application.yml의 ${환경변수} 방식을 쓴다
.env
application-local.yml
application-secret.yml

# ── 로그 ─────────────────────────────
*.log
logs/

# 디자인 목업
# hifi 화면 시안(PNG). 참고용으로 로컬에 두되 커밋하지 않는다.
# 백엔드 레포에 수 MB 바이너리가 쌓이면 clone이 무거워지고,
# 시안의 원본은 디자인 도구에 있어 여기가 진실의 출처가 아니다.
hifi/
